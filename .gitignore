# Source documents — keep these OUT of the repo (may be copyrighted). A sample is
# tracked so the project runs out of the box; everything else under data/ is ignored.
data/*
!data/sample.md

# Derived index (embeddings of your documents) and its manifest
chroma_db/

# Python
__pycache__/
*.pyc
*.pyo

# Logs / temp - includes the query + feedback JSONL (the user's own queries; never push)
*.log
*.log.err
logs/

# Machine-local config kept out of the repo: personal source paths + private eval sets
*.local.json
